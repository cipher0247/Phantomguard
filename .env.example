# Copy to .env (never commit).
PORT=8787
NODE_ENV=development
# AI advisor (generative advice, NOT a trained detection model); keep real keys in .env only.
GEMINI_API_KEY=AQ.Ab8RN6LjO17GiPSDapPb47qHcA2acQeoz5TsYZ1TXfbo8lejvg
GEMINI_ADVISOR_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-haiku-5-5
# Trained-model inference services. Each is an HTTP endpoint you run; see README for the contract.
PG_TEXT_MODEL_URL=
PG_AUDIO_MODEL_URL=
PG_VIDEO_MODEL_URL=
# Per-request model timeout in ms (default 15000 for text, 120000 for audio/video)
PG_MODEL_TIMEOUT_MS=
# Number of reverse proxies in front of the server (needed for correct client IPs in rate limiting)
PG_TRUST_PROXY=
# Comma-separated extra origins allowed to make state-changing API calls (normally empty)
PG_ALLOWED_ORIGINS=
