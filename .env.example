# Copy to .env (never commit). All optional except PG_SESSION_SECRET in production.
PORT=8787
NODE_ENV=development
# AI advisor (generative advice, NOT a trained detection model)
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-haiku-5-5
# Trained-model inference services. Each is an HTTP endpoint you run; see README for the contract.
PG_TEXT_MODEL_URL=
PG_AUDIO_MODEL_URL=
PG_VIDEO_MODEL_URL=
